# Copy this file to .env and fill in the values. Never commit .env.

# --- xAI / Grok (generation + query rewriting only) ---
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Check the current model id in the xAI console
XAI_CHAT_MODEL=

# --- Embeddings (local, sentence-transformers) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# --- Chunking (bge max is 512 tokens; keep CHUNK_SIZE <= 500) ---
CHUNK_SIZE=350
CHUNK_OVERLAP=60

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
# One collection per chunk config, e.g. rag_200_40, rag_350_60, rag_480_80
QDRANT_COLLECTION=rag_350_60

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
SESSION_TTL_SECONDS=86400
SESSION_MAX_STORED_MESSAGES=50
HISTORY_MESSAGES_IN_PROMPT=8

# --- Retrieval ---
TOP_K=5

# --- Paths ---
DOCUMENTS_DIR=documents
