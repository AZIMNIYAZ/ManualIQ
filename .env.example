# Copy this file to .env and fill in the values. Never commit .env.

# --- xAI / Grok (generation + query rewriting only) ---
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Check the current model id in the xAI console
XAI_CHAT_MODEL=
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=800
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Optional, from xAI's pricing page (USD per million tokens), for cost estimates
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=
# Context sent to the LLM (bge tokens)
CONTEXT_MAX_TOKENS=2500

# --- Embeddings (local, sentence-transformers) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Pinned snapshot of the model (changing it means re-embedding everything)
EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
EMBEDDING_DIM=384
# 16 measured fastest on CPU (16: 9.0, 32: 7.3, 64: 5.9 chunks/s)
EMBEDDING_BATCH_SIZE=16
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# --- Chunking (bge max is 512 tokens; keep CHUNK_SIZE <= 500) ---
CHUNK_SIZE=350
CHUNK_OVERLAP=60

# --- Qdrant ---
# 127.0.0.1, not localhost: on Windows localhost tries IPv6 first, doubling timeouts
QDRANT_URL=http://127.0.0.1:6333
# Collection name = {prefix}_{CHUNK_SIZE}_{CHUNK_OVERLAP}[_{suffix}], e.g. rag_350_60 (derived, not set by hand)
QDRANT_COLLECTION_PREFIX=rag
QDRANT_COLLECTION_SUFFIX=

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SESSION_TTL_SECONDS=86400
SESSION_MAX_STORED_MESSAGES=50
HISTORY_MESSAGES_IN_PROMPT=8

# --- Retrieval ---
TOP_K=5

# --- Paths ---
DOCUMENTS_DIR=documents
