{
  "info": {
    "name": "RAG Backend",
    "description": "Requests for the conversational RAG backend. Start the API with: uvicorn app.main:app --reload",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "collection",
      "value": "rag_350_60"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('All services ok', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('ok');",
              "  pm.expect(body.qdrant).to.eql('ok');",
              "  pm.expect(body.redis).to.eql('ok');",
              "});",
              "pm.test('Has X-Request-ID header', () => pm.response.to.have.header('X-Request-ID'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ingest (takes ~2 minutes)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recreate\": false\n}"
        },
        "url": "{{base_url}}/api/v1/ingest"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('All chunks indexed and verified', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('success');",
              "  pm.expect(body.collection_state).to.eql('updated');",
              "  pm.expect(body.chunks_indexed).to.eql(body.chunks_created);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Ingest - recreate (deletes and rebuilds the collection)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recreate\": true,\n  \"confirm\": \"{{collection}}\"\n}"
        },
        "url": "{{base_url}}/api/v1/ingest"
      }
    },
    {
      "name": "Ingest - recreate without confirm (expect 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recreate\": true\n}"
        },
        "url": "{{base_url}}/api/v1/ingest"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Refused with 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Search - brand detected from the question",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"How do I set up port forwarding on the Netgear router?\",\n  \"top_k\": 5\n}"
        },
        "url": "{{base_url}}/api/v1/search"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Netgear detected and only Netgear results', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.filters.brands).to.eql(['netgear']);",
              "  pm.expect(body.filters.brand_source).to.eql('detected');",
              "  body.results.forEach(r => pm.expect(r.brand).to.eql('netgear'));",
              "});",
              "pm.test('No regulatory chunks by default', () => pm.response.json().results.forEach(r => pm.expect(r.content_type).to.eql('normal')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Search - no brand (all manuals)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"How do I update the router firmware?\",\n  \"top_k\": 5\n}"
        },
        "url": "{{base_url}}/api/v1/search"
      }
    },
    {
      "name": "Search - explicit brand",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"How do I update the router firmware?\",\n  \"brand\": \"asus\",\n  \"top_k\": 5\n}"
        },
        "url": "{{base_url}}/api/v1/search"
      }
    },
    {
      "name": "Search - include regulatory",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"FCC radiation exposure statement\",\n  \"include_regulatory\": true,\n  \"top_k\": 5\n}"
        },
        "url": "{{base_url}}/api/v1/search"
      }
    },
    {
      "name": "Search - Tenda default IP (known miss: table)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"What is the default login IP address of the Tenda router?\",\n  \"top_k\": 5\n}"
        },
        "url": "{{base_url}}/api/v1/search"
      }
    },
    {
      "name": "Search - unknown brand (expect 422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"reset the router\",\n  \"brand\": \"linksys\"\n}"
        },
        "url": "{{base_url}}/api/v1/search"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Refused with 422', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    }
  ]
}
