{
  "info": {
    "name": "RAG Backend",
    "description": "Requests for the conversational RAG backend. Start the API with: uvicorn app.main:app --reload",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "collection",
      "value": "rag_350_60"
    },
    {
      "key": "session_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('All services ok', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('ok');",
              "  pm.expect(body.qdrant).to.eql('ok');",
              "  pm.expect(body.redis).to.eql('ok');",
              "});",
              "pm.test('Has X-Request-ID header', () => pm.response.to.have.header('X-Request-ID'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ingest (takes ~2 minutes)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recreate\": false\n}"
        },
        "url": "{{base_url}}/api/v1/ingest"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('All chunks indexed and verified', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('success');",
              "  pm.expect(body.collection_state).to.eql('updated');",
              "  pm.expect(body.chunks_indexed).to.eql(body.chunks_created);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Ingest - recreate (deletes and rebuilds the collection)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recreate\": true,\n  \"confirm\": \"{{collection}}\"\n}"
        },
        "url": "{{base_url}}/api/v1/ingest"
      }
    },
    {
      "name": "Ingest - recreate without confirm (expect 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recreate\": true\n}"
        },
        "url": "{{base_url}}/api/v1/ingest"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Refused with 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Search - brand detected from the question",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"How do I set up port forwarding on the Netgear router?\",\n  \"top_k\": 5\n}"
        },
        "url": "{{base_url}}/api/v1/search"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Netgear detected and only Netgear results', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.filters.brands).to.eql(['netgear']);",
              "  pm.expect(body.filters.brand_source).to.eql('detected');",
              "  body.results.forEach(r => pm.expect(r.brand).to.eql('netgear'));",
              "});",
              "pm.test('No regulatory chunks by default', () => pm.response.json().results.forEach(r => pm.expect(r.content_type).to.eql('normal')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Search - no brand (all manuals)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"How do I update the router firmware?\",\n  \"top_k\": 5\n}"
        },
        "url": "{{base_url}}/api/v1/search"
      }
    },
    {
      "name": "Search - explicit brand",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"How do I update the router firmware?\",\n  \"brand\": \"asus\",\n  \"top_k\": 5\n}"
        },
        "url": "{{base_url}}/api/v1/search"
      }
    },
    {
      "name": "Search - include regulatory",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"FCC radiation exposure statement\",\n  \"include_regulatory\": true,\n  \"top_k\": 5\n}"
        },
        "url": "{{base_url}}/api/v1/search"
      }
    },
    {
      "name": "Search - Tenda default IP (known miss: table)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"What is the default login IP address of the Tenda router?\",\n  \"top_k\": 5\n}"
        },
        "url": "{{base_url}}/api/v1/search"
      }
    },
    {
      "name": "Search - unknown brand (expect 422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"reset the router\",\n  \"brand\": \"linksys\"\n}"
        },
        "url": "{{base_url}}/api/v1/search"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Refused with 422', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "Chat - cited answer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"How do I set up port forwarding on the Netgear router?\"\n}"
        },
        "url": "{{base_url}}/api/v1/chat"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Answer found and cited', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.found_in_documents).to.be.true;",
              "  pm.expect(body.sources.length).to.be.above(0);",
              "  pm.expect(body.answer).to.match(/\\[\\d+\\]/);",
              "});",
              "pm.test('No grounding warnings', () => pm.expect(pm.response.json().warnings).to.eql([]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Chat - debug (shows the context sent to the LLM)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"How do I enable the firewall on the ASUS router?\",\n  \"debug\": true\n}"
        },
        "url": "{{base_url}}/api/v1/chat"
      }
    },
    {
      "name": "Chat - grounding test: Tenda default IP (expect not found)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"What is the default login IP address of the Tenda router?\"\n}"
        },
        "url": "{{base_url}}/api/v1/chat"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Refuses instead of answering from general knowledge', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.found_in_documents).to.be.false;",
              "  pm.expect(body.sources).to.eql([]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Chat - out of scope (expect not found)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"What is the weather forecast for tomorrow?\"\n}"
        },
        "url": "{{base_url}}/api/v1/chat"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Not found', () => pm.expect(pm.response.json().found_in_documents).to.be.false);"
            ]
          }
        }
      ]
    },
    {
      "name": "Conversation 1/2 - new session (Netgear)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/chat",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"How do I set up port forwarding on my Netgear router?\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('session_id', body.session_id);  // used by the next requests",
              "pm.test('New session, no rewrite', () => { pm.expect(body.history_used).to.eql(0); pm.expect(body.rewritten_query).to.be.null; });"
            ]
          }
        }
      ]
    },
    {
      "name": "Conversation 2/2 - follow-up 'What about on ASUS?'",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/chat",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"What about on ASUS?\",\n  \"session_id\": \"{{session_id}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Rewritten to a standalone ASUS question', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.history_used).to.eql(2);",
              "  pm.expect(body.rewritten_query.toLowerCase()).to.include('asus');",
              "  pm.expect(body.filters.brands).to.eql(['asus']);",
              "  pm.expect(body.filters.brand_source).to.eql('rewrite');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Session - get history",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/sessions/{{session_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Two turns stored', () => pm.expect(pm.response.json().messages.length).to.eql(4));"
            ]
          }
        }
      ]
    },
    {
      "name": "Session - delete",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/api/v1/sessions/{{session_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Deleted (204)', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Session - get after delete (expect 404)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/sessions/{{session_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Gone (404)', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
